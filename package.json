{
	"name": "wakuwaku-template-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"typescript/*"
	],
	"scripts": {
		"dev": "bun run --filter guru-frontend dev",
		"build": "bun run --filter guru-frontend build",
		"check:svelte": "bun run --filter guru-frontend check",
		"docs:dev": "bun run --filter guru-docs dev",
		"docs:build": "bun run --filter guru-docs build",
		"docs:preview": "bun run --filter guru-docs preview",
		"check:docs": "bun run --filter guru-docs check",
		"generate:proto": "bun run --filter app-protobuf generate:proto",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"trustedDependencies": [
		"grpc-tools",
		"protobufjs"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.12"
	}
}
